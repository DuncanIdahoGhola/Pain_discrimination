        <Param val="Bienvenue dans le programme de calibration de discrimination.&amp;#10;&amp;#10;Si vous ressentez une différence de chaleur pendant la stimulation, &amp;#10;veuillez sélectionner OUI ou NON à l'aide de la boîte de commande.&amp;#10;&amp;#10;Expérimentateur.trice, appuyer sur 'p' démarrer l'expérience&amp;#10;&amp;#10;Bonne expérience.&amp;#10;" valType="str" updates="constant" name="text"/>
