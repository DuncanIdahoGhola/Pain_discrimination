      <CodeComponent name="trigger_pic" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;# Get pic stim&amp;#10;pic_str = str(int(np.round(temp_pic_set, 1)*10))&amp;#10;temp_flat_str = str(int(np.round(temp_flat, 1)*10))&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="pic_str = Number.parseInt((np.round(temp_pic_set, 1) * 10)).toString();&amp;#10;temp_flat_str = Number.parseInt((np.round(temp_flat, 1) * 10)).toString();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="thermode_localisation = (&quot;T : &quot; + loc.toString());&amp;#10;response_pic = null;&amp;#10;dur_plateau_1 = util.round(Math.random.uniform(3.25, 4.75), 2);&amp;#10;dur_plateau_2 = util.round((10 - (dur_plateau_1 + 1.2)), 2);&amp;#10;start1 = 3;&amp;#10;start2 = 8;&amp;#10;dur_send = Number.parseInt((dur_plateau_1 * 100)).toString();&amp;#10;dur_send2 = Number.parseInt((dur_plateau_2 * 100)).toString();&amp;#10;if ((pic === &quot;pic-present&quot;)) {&amp;#10;    port_thermode.port.write(&quot;Ue11111&quot;.encode());&amp;#10;    port_thermode.set_rd_plateau({&quot;temp_plateau&quot;: temp_flat_str, &quot;temp_pic&quot;: pic_str, &quot;dur_plateau_1_10ms&quot;: dur_send, &quot;dur_plateau_2_10ms&quot;: dur_send2});&amp;#10;} else {&amp;#10;    port_thermode.port.write(&quot;Ue11111&quot;.encode());&amp;#10;    port_thermode.set_rd_plateau({&quot;temp_plateau&quot;: temp_flat_str, &quot;temp_pic&quot;: temp_flat_str, &quot;dur_plateau_1_10ms&quot;: dur_send, &quot;dur_plateau_2_10ms&quot;: dur_send2});&amp;#10;}&amp;#10;out_file = `data/${expInfo[&quot;participant&quot;]}_${data.getDateStr({&quot;format&quot;: &quot;%Y-%m-%d&quot;})}/${expInfo[&quot;participant&quot;]}_${expName}_${expInfo[&quot;date&quot;]}${(((expInfo[&quot;participant&quot;] + &quot;_temp_trial_pic_&quot;) + curr_item_discri.toString().zfill(2)) + &quot;.csv&quot;)}`;&amp;#10;stim_thread = new threading.Thread({&quot;target&quot;: port_thermode.trigger_and_save_temp_rd, &quot;args&quot;: [out_file, 11500]});&amp;#10;stim_thread.start();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="thermode_localisation = 'T : ' + str(loc) &amp;#10;response_pic = None&amp;#10;&amp;#10;# Jitter duration&amp;#10;dur_plateau_1 = round(random.uniform(3.25, 4.75), 2)&amp;#10;&amp;#10;# Plateau 2 is difference 10.95 - others&amp;#10;dur_plateau_2 = round(10 - (dur_plateau_1 + 1.2), 2)&amp;#10;&amp;#10;# Detection cue always start at 3.5&amp;#10;start1 = 3&amp;#10;# Responses start after rise to plateau + plateau + pic (1.2)&amp;#10;start2 = 8&amp;#10;&amp;#10;&amp;#10;# Convert to string&amp;#10;dur_send = str(int(dur_plateau_1*100))&amp;#10;dur_send2 = str(int(dur_plateau_2*100))&amp;#10;&amp;#10;#Pic or not?&amp;#10;&amp;#10;if pic == 'pic-present' :&amp;#10;    # Set thermode&amp;#10;    port_thermode.port.write('Ue11111'.encode())&amp;#10;    port_thermode.set_rd_plateau(temp_plateau=temp_flat_str,&amp;#10;                      temp_pic=pic_str,&amp;#10;                      dur_plateau_1_10ms=dur_send,&amp;#10;                      dur_plateau_2_10ms=dur_send2)&amp;#10;else :&amp;#10;    # Set thermode&amp;#10;    port_thermode.port.write('Ue11111'.encode())&amp;#10;    port_thermode.set_rd_plateau(temp_plateau=temp_flat_str,&amp;#10;                      temp_pic=temp_flat_str,&amp;#10;                      dur_plateau_1_10ms=dur_send,&amp;#10;                      dur_plateau_2_10ms=dur_send2)&amp;#10;&amp;#10;# Trigger thermode in other thread&amp;#10;out_file = u'data/%s_%s/%s_%s_%s%s' % (expInfo['participant'], data.getDateStr(format=&quot;%Y-%m-%d&quot;), expInfo['participant'], expName, expInfo['date'], expInfo['participant'] + '_temp_trial_pic_' + str(curr_item_discri).zfill(2) + '.csv')&amp;#10;stim_thread = threading.Thread(target=port_thermode.trigger_and_save_temp_rd,&amp;#10;                     args=(out_file, 11500,))&amp;#10;stim_thread.start()&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="#Polygon normal avant signal&amp;#10;if (t &lt;= dur_plateau_1) and cond == 'active': &amp;#10;    polygon_1.draw()&amp;#10;if (t &lt;= dur_plateau_1) and cond == 'inactive':&amp;#10;    polygon_2.draw()&amp;#10;&amp;#10;#Remplir en noir pour signal&amp;#10;if(t &gt;= start1) and cond == 'active' and (t &lt;= start2): &amp;#10;    polygon_1.draw()&amp;#10;    polygon_1_black.draw()&amp;#10;if (t &gt;= start1) and cond == 'inactive' and (t &lt;= start2): &amp;#10;    polygon_2.draw()&amp;#10;    polygon_2_black.draw()&amp;#10;# Check response and change color answer&amp;#10;if discrimin_resp.status == STARTED and len(discrimin_resp.keys) != 0:&amp;#10;    if discrimin_resp.keys[-1] == 'm':&amp;#10;        responsel.color = (0, 0, 0)&amp;#10;        response_pic = detectr&amp;#10;    elif discrimin_resp.keys[-1] == 'n':&amp;#10;        responser.color = (0, 0, 0)&amp;#10;        response_pic = detectl&amp;#10;&amp;#10;#if (t &gt;= 7.90) :&amp;#10;    #win.flip()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((t &lt;= dur_plateau_1) &amp;&amp; (cond === &quot;active&quot;))) {&amp;#10;    polygon_1.draw();&amp;#10;}&amp;#10;if (((t &lt;= dur_plateau_1) &amp;&amp; (cond === &quot;inactive&quot;))) {&amp;#10;    polygon_2.draw();&amp;#10;}&amp;#10;if ((((t &gt;= start1) &amp;&amp; (cond === &quot;active&quot;)) &amp;&amp; (t &lt;= start2))) {&amp;#10;    polygon_1.draw();&amp;#10;    polygon_1_black.draw();&amp;#10;}&amp;#10;if ((((t &gt;= start1) &amp;&amp; (cond === &quot;inactive&quot;)) &amp;&amp; (t &lt;= start2))) {&amp;#10;    polygon_2.draw();&amp;#10;    polygon_2_black.draw();&amp;#10;}&amp;#10;if (((discrimin_resp.status === PsychoJS.Status.STARTED) &amp;&amp; (discrimin_resp.keys.length !== 0))) {&amp;#10;    if ((discrimin_resp.keys.slice((- 1))[0] === &quot;m&quot;)) {&amp;#10;        responsel.color = [0, 0, 0];&amp;#10;        response_pic = detectr;&amp;#10;    } else {&amp;#10;        if ((discrimin_resp.keys.slice((- 1))[0] === &quot;n&quot;)) {&amp;#10;            responser.color = [0, 0, 0];&amp;#10;            response_pic = detectl;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="trials.addData(&quot;dur_plateau1&quot;, dur_plateau_1);&amp;#10;trials.addData(&quot;dur_plateau2&quot;, dur_plateau_2);&amp;#10;trials.addData(&quot;dur_plateau1_sent&quot;, dur_send);&amp;#10;trials.addData(&quot;dur_plateau2_sent&quot;, dur_send2);&amp;#10;trials.addData(&quot;start_plateau_2_resp&quot;, start2);&amp;#10;trials.addData(&quot;dur_pic&quot;, 1.2);&amp;#10;trials.addData(&quot;dur_rise&quot;, 0.75);&amp;#10;psychoJS.experiment.addData(&quot;loca_thermode&quot;, loc);&amp;#10;psychoJS.experiment.addData(&quot;condition&quot;, cond);&amp;#10;psychoJS.experiment.addData(&quot;pic_presence&quot;, pic);&amp;#10;trials.addData(&quot;pic_response&quot;, response_pic);&amp;#10;responsel.color = &quot;white&quot;;&amp;#10;responser.color = &quot;white&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="trials.addData('dur_plateau1', dur_plateau_1)&amp;#10;trials.addData('dur_plateau2', dur_plateau_2)&amp;#10;trials.addData('dur_plateau1_sent', dur_send)&amp;#10;trials.addData('dur_plateau2_sent', dur_send2)&amp;#10;trials.addData('start_plateau_2_resp', start2)&amp;#10;trials.addData('dur_pic', 1.2)&amp;#10;trials.addData('dur_rise', 0.75)&amp;#10;&amp;#10;thisExp.addData('loca_thermode', loc)&amp;#10;thisExp.addData('condition', cond)&amp;#10;thisExp.addData('pic_presence', pic)&amp;#10;trials.addData('pic_response', response_pic)&amp;#10;# Reset color&amp;#10;responsel.color = 'white'&amp;#10;responser.color = 'white'" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
