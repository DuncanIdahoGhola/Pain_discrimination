      <CodeComponent name="Stim_selection" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="port_thermode.port.write(&quot;Ue00000&quot;.encode());&amp;#10;dur_plateau1 = 4;&amp;#10;dur_plateau2 = 4.8;&amp;#10;console.log(cond);&amp;#10;if ((cond === &quot;inactive&quot;)) {&amp;#10;    port_thermode.set_stim({&quot;target&quot;: temp_flat, &quot;rise_rate&quot;: rise_flat, &quot;return_rate&quot;: rise_flat, &quot;dur_ms&quot;: 11500, &quot;dur_mode&quot;: &quot;fixed_total&quot;, &quot;surfaces&quot;: [1, 2, 3, 4, 5]});&amp;#10;    temp_trial_sent = temp_flat;&amp;#10;} else {&amp;#10;    if ((cond === &quot;active&quot;)) {&amp;#10;        port_thermode.set_stim({&quot;target&quot;: temp_active, &quot;rise_rate&quot;: rise_active, &quot;return_rate&quot;: rise_active, &quot;dur_ms&quot;: 11500, &quot;dur_mode&quot;: &quot;fixed_total&quot;, &quot;surfaces&quot;: [1, 2, 3, 4, 5]});&amp;#10;        temp_trial_sent = temp_active;&amp;#10;    }&amp;#10;}&amp;#10;console.log(temp_trial_sent);&amp;#10;out_file = `data/${expInfo[&quot;participant&quot;]}_${data.getDateStr({&quot;format&quot;: &quot;%Y-%m-%d&quot;})}/${expInfo[&quot;participant&quot;]}_${expName}_${expInfo[&quot;date&quot;]}${(((expInfo[&quot;participant&quot;] + &quot;_temp_trial_eval_cond_&quot;) + curr_item_test.toString().zfill(2)) + &quot;.csv&quot;)}`;&amp;#10;stim_thread = new threading.Thread({&quot;target&quot;: port_thermode.trigger_and_save_temp_rd, &quot;args&quot;: [out_file, 11500]});&amp;#10;stim_thread.start();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;# Disable temp profile&amp;#10;port_thermode.port.write('Ue00000'.encode())&amp;#10;&amp;#10;dur_plateau1 = 4&amp;#10;dur_plateau2 = 4.8&amp;#10;print(cond)&amp;#10;if cond == 'inactive' :&amp;#10;    port_thermode.set_stim(target=temp_flat, rise_rate=rise_flat, return_rate=rise_flat,&amp;#10;                dur_ms=11500,&amp;#10;                dur_mode='fixed_total',&amp;#10;                surfaces=[1, 2, 3, 4, 5])&amp;#10;    temp_trial_sent = temp_flat&amp;#10;&amp;#10;elif cond == 'active' :&amp;#10;    port_thermode.set_stim(target=temp_active, rise_rate=rise_active, return_rate=rise_active,&amp;#10;                dur_ms=11500,&amp;#10;                dur_mode='fixed_total',&amp;#10;                surfaces=[1, 2, 3, 4, 5])&amp;#10;    temp_trial_sent = temp_active&amp;#10;print(temp_trial_sent)&amp;#10;## Trigger thermode in other thread&amp;#10;out_file = u'data/%s_%s/%s_%s_%s%s' % (expInfo['participant'], data.getDateStr(format=&quot;%Y-%m-%d&quot;), expInfo['participant'], expName, expInfo['date'], expInfo['participant'] + '_temp_trial_eval_cond_' + str(curr_item_test).zfill(2) + '.csv')&amp;#10;stim_thread = threading.Thread(target=port_thermode.trigger_and_save_temp_rd,&amp;#10;                                args=(out_file, 11500,))&amp;#10;stim_thread.start()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if cond == 'active' :&amp;#10;    polygon_1.draw()&amp;#10;else :&amp;#10;    polygon_2.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((cond === &quot;active&quot;)) {&amp;#10;    polygon_1.draw();&amp;#10;} else {&amp;#10;    polygon_2.draw();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="loop_test.addData(&quot;loca_thermode&quot;, loc);&amp;#10;loop_test.addData(&quot;condition&quot;, cond);&amp;#10;loop_test.addData(&quot;temp_trial_sent&quot;, temp_trial_sent);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="loop_test.addData('loca_thermode', loc)&amp;#10;loop_test.addData('condition', cond)&amp;#10;loop_test.addData('temp_trial_sent', temp_trial_sent)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
